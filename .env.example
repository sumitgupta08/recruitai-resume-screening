# ══════════════════════════════════════════════════════════════
# RecruitAI Environment Variables — COPY TO .env AND FILL IN
# Never commit the actual .env file to version control.
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
ENV=development                         # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-256-bit-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database (PostgreSQL + pgvector) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/recruitai
POSTGRES_PASSWORD=postgres

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object Storage (MinIO for dev, S3 for production) ────────
S3_ENDPOINT_URL=http://minio:9000        # comment out for real AWS S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=resumes
S3_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── ML Models ─────────────────────────────────────────────────
SPACY_MODEL=en_core_web_lg              # en_core_web_sm for faster/smaller
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Scoring Weights (must sum to 1.0) ────────────────────────
WEIGHT_SKILLS=0.40
WEIGHT_EXPERIENCE=0.30
WEIGHT_EDUCATION=0.15
WEIGHT_SEMANTIC=0.15

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=                             # leave empty to disable Sentry
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
